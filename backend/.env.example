# Optional shell environment settings. .env is not loaded automatically.
DATABASE_URL=sqlite:///factory.db
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PORT=5000
APP_TIMEZONE=Africa/Nairobi
# Production requires APP_ENV=production, a PostgreSQL DATABASE_URL,
# an HTTPS public URL and explicit HTTPS origins, and a long JWT secret.
# JWT_SECRET_KEY=generate-at-least-32-random-characters
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=factory@example.com
