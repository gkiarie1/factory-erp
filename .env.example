# Copy to .env for Docker Compose. Replace all placeholders before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password. The Compose database hostname is db.
DATABASE_URL=postgresql://factory:replace-with-a-long-random-password@db:5432/factory
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=https://factory.example.com
APP_TIMEZONE=Africa/Nairobi
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Factory <factory@example.com>
